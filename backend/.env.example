# OPAL LINE ERP — Environment Variables
# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to Git.

# Server
PORT=5000
NODE_ENV=development

# Frontend origin allowed to call the API (CORS)
CLIENT_URL=http://localhost:5173

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/opal_line"

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Shopify (Phase 15+)
SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret
SHOPIFY_ACCESS_TOKEN=your-shopify-access-token
SHOPIFY_WEBHOOK_SECRET=your-shopify-webhook-secret

# Email (SMTP) — used for password reset emails.
# If SMTP_HOST is not set, emails are logged to console (dev fallback).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@opalline.com

# Seed admin (used by prisma/seed.js)
SEED_ADMIN_EMAIL=admin@opalline.com
SEED_ADMIN_PASSWORD=change-me
