# OPAL LINE ERP — Environment Variables
# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to Git.

# Server
PORT=5000
NODE_ENV=development

# Frontend origin allowed to call the API (CORS)
CLIENT_URL=http://localhost:5173

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/opal_line"

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Shopify (Phase 15+)
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
