# =============================================================
# OPAL LINE ERP — root .gitignore
# Protects secrets and build junk across the WHOLE repo.
# The frontend/ and backend/ folders have their own .gitignore too.
# =============================================================

# Environment files (NEVER commit secrets)
.env
.env.*
!.env.example

# Local analysis notes (personal — never committed)
analysis/

# Node
node_modules/

# Build output
dist/
build/

# Logs
*.log
dev.log

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Playwright
e2e/.auth/
test-results/
playwright-report/

# Throwaway / local scripts (never commit) — see docs/AGENTS.md
.freebuff/
backend/check-sync.js
backend/e2e-check.js
backend/run-inventory-sync.js
backend/scratch_prod_inspect.js
backend/src/scripts/
backend/test-hosted-login.js
backend/test-hosted-upload.js
backend/test-shopify.js
